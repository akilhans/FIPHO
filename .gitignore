# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!registration-backend/.env.example
!registration-frontend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# django backend
registration-backend/.venv/
registration-backend/db.sqlite3
registration-backend/logs/
registration-backend/media/
registration-backend/staticfiles/
registration-backend/**/*.pyc
registration-backend/**/__pycache__/

# registration frontend
registration-frontend/node_modules/
registration-frontend/.next/
